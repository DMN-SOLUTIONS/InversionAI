*.py[cod]
*$py.class
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables (secrets)
.env
.streamlit/secrets.toml

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Tomofast-x build artifacts
Tomofast-x/obj/
Tomofast-x/tomofastx

# Output and results
output/
results/

# Large data files
*.vtk

# Node
node_modules/

# Jupyter
.ipynb_checkpoints/

# pytest
.pytest_cache/
.coverage
htmlcov/
